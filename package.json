{
	"name": "idle-rpg-game",
	"description": "A simple idle RPG",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Microsoft/vscode-extension-samples"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"extensionKind": [
		"ui",
		"workspace"
	],
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"views": {
			"explorer": [
				{
					"type": "webview",
					"id": "idleGame.gameView",
					"name": "Idle Game"
				}
			]
		},
		"commands": [
			{
				"command": "idleGame.addColor",
				"category": "Idle Game",
				"title": "Add Color"
			},
			{
				"command": "idleGame.clearColors",
				"category": "Idle Game",
				"title": "Clear Colors",
				"icon": "$(clear-all)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "idleGame.clearColors",
					"group": "navigation",
					"when": "view == idleGame.gameView"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -w -p ./"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/vscode": "^1.73.0",
		"eslint": "^9.13.0",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.0"
	},
	"dependencies": {
		"idle-rpg-game": "file:"
	}
}
